# Analyst Agent — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

PYTHONPATH=/path/to/analyst-agent

# LLM API key — at least one provider is required
# Google Gemini: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# LangSmith tracing (optional but recommended for dev)
# LangSmith tracing (optional but recommended for dev)
export LANGSMITH_TRACING=true
export LANGSMITH_ENDPOINT=https://api.smith.langchain.com
export LANGSMITH_API_KEY=
export LANGSMITH_PROJECT="Analyst Agent"

# OpenTelemetry tracing (optional; OFF unless an OTLP endpoint is set)
# One trace per chat question: graph steps, tool calls and LLM calls with
# timings and token counts, via OpenInference. Exported over OTLP/HTTP only
# (OTEL_EXPORTER_OTLP_PROTOCOL is not used; point at an OTLP/HTTP endpoint).
# Local viewer example (Arize Phoenix, `uvx arize-phoenix serve`, UI on :6006):
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=analyst-agent
# Force tracing off even when an endpoint is set:
# OTEL_SDK_DISABLED=true
# Sampling: keep a fraction of traces (default: all)
# OTEL_TRACES_SAMPLER=traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# Cap on any single span attribute value, in characters (default 8192)
# OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=8192
# Redaction: keep prompts/answers out of exported spans
# OPENINFERENCE_HIDE_INPUTS=true
# OPENINFERENCE_HIDE_OUTPUTS=true
# Key for the user_hash tag on chat traces (HMAC of the signed-in user id).
# Set a long random value to correlate a user's runs across restarts; unset,
# a random per-process key is used. e.g. `openssl rand -hex 32`
# TRACE_HASH_SECRET=

# Budget units per signed-in user per UTC day paid by the operator's keys
# (BYOK traffic is never counted). One unit = one call on the default model;
# a pricier model's call costs its models.json price over the default's,
# rounded up. A chat question is ~3-4 calls. (default 350)
# LLM_DAILY_BUDGET=350


# SEC EDGAR requires identification — use your name and email
# e.g. "Jane Doe jane@example.com"
SEC_HEADER=Your Name your@email.com

# Tavily API key (optional — enables web research tools)
# Get one at: https://tavily.com
TAVILY_API_KEY=

# Logging (optional; an unknown level name falls back to the default)
# App log level (default INFO)
# LOG_LEVEL=INFO
# edgartools log level; it is very chatty at INFO (default WARNING)
# EDGAR_LOG_LEVEL=WARNING

# How long a filing analysis is served before SEC EDGAR is re-checked for a
# newer filing, in seconds (default 14400 = 4h)
# FILING_FRESHNESS_TTL_SECONDS=14400

# Max seconds shutdown waits for pending chat/message DB writes (default 5)
# DB_CLOSE_DRAIN_TIMEOUT_SECONDS=5
